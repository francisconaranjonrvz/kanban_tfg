# Copia este archivo a .env y rellena los valores

# Tu dominio (sin https://)
DOMAIN=tu-dominio.freemyip.com

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esto-por-un-secreto-largo

# PostgreSQL
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=cambia-esta-password

# Email para Let's Encrypt
LETSENCRYPT_EMAIL=tu@email.com
